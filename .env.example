# Copy to .env and fill in. Every value has a safe default for local dev
# except when you want Postgres / Cloudinary.

DEBUG=True
SECRET_KEY=change-me

# Hosts / CSRF (comma-separated). Defaults cover localhost + *.onrender.com.
# ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database. Leave unset to use a local SQLite file (db.sqlite3).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_REQUIRE_SSL=True

# Cloudinary. Leave unset to store uploaded media on the local filesystem.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Used by `python manage.py create_admin` (skipped if unset).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
